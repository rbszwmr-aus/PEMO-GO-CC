# PEMO development environment — EXAMPLE ONLY.
#
# Copy to database/dev/.env and set a local development password. That file is
# git-ignored. No real credential, secret or key belongs anywhere in this
# repository, in a report, or in chat. Sanitized examples only.
#
# One file, read by two consumers:
#   * docker compose reads the POSTGRES_* entries
#   * the Go binaries read the PEMO_* entries (pemo-api / pemo load this file)

# ---- docker compose (database/dev/docker-compose.yml) ----
POSTGRES_DB=pemo_dev
# The image creates this role and it becomes the OWNER of every schema and
# table. Migrations run as it. The application never uses it.
POSTGRES_USER=pemo_owner
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=25480

# ---- API ----
# PEMO_ENV must be exactly "development". The process REFUSES TO START otherwise:
# this build contains a development-only authentication stub and a development-only
# fault seam, and neither may ever run against a real environment.
PEMO_ENV=development
PEMO_HTTP_HOST=127.0.0.1
# 23280: clear of the Node build (8080/3200) and every other project on this machine.
PEMO_HTTP_PORT=23280
PEMO_LOG_LEVEL=info
PEMO_DB_HOST=127.0.0.1
PEMO_DB_PORT=25480
PEMO_DB_NAME=pemo_dev
# TWO KINDS OF ROLE, and the separation is the point.
#
#   PEMO_DB_USER        legacy shared login (pemo_app). Still created, and still
#                       required so existing env files load, but 010-grants
#                       leaves it with no table rights — a forgotten connection
#                       fails closed.
#   pemo_app_<schema>   what each module pool actually connects as. One login
#                       per existing pool, member of only its own privilege
#                       role. Dev may share PEMO_DB_PASSWORD (or
#                       PEMO_DB_MODULE_PASSWORD) across them; override a single
#                       login with PEMO_DB_USER_<SCHEMA> / PEMO_DB_PASSWORD_<SCHEMA>.
#   PEMO_DB_OWNER_USER  pemo_owner — migrations, seeds, boundary verification
#                       and the test harness. Owns the schemas.
#
# `pemo bootstrap` (database/bootstrap.sh) creates the module logins and sets their passwords from
# the environment, so no credential lives in a tracked file.
PEMO_DB_USER=pemo_app
PEMO_DB_PASSWORD=replace-with-a-local-development-password-for-the-app-role
# Optional. Defaults to pemo_app_. Module logins are ${PEMO_DB_LOGIN_PREFIX}<schema>.
# PEMO_DB_LOGIN_PREFIX=pemo_app_
# Optional. If unset, every module login uses PEMO_DB_PASSWORD.
# PEMO_DB_MODULE_PASSWORD=replace-with-a-local-development-password-for-module-logins
PEMO_DB_OWNER_USER=pemo_owner
PEMO_DB_OWNER_PASSWORD=replace-with-a-local-development-password
# Development-only signing secret for the auth stub. Not a production key, and
# not a secret worth protecting — it signs development tokens for seeded
# residents on a loopback-only service.
PEMO_DEV_TOKEN_SECRET=replace-with-any-local-development-string
# Lifetime of a development token, in seconds. One hour by default: long enough
# that a live client suite cannot age out mid-run, short enough to be a TTL.
PEMO_DEV_TOKEN_TTL_SECONDS=3600

# ---- Go build additions (all optional) ----
# In-memory demo routes (tickets, invoices, notices/visitors, QR pass) on the
# main API. Off by default: they are unaudited and never part of the product.
# The UIs' demo paths normally go to the standalone pemo-demo on :23283.
# PEMO_ENABLE_DEMO_ROUTES=1
# Display time zone (was the 'Asia/Hong_Kong' literal in 18 Node files).
# PEMO_TIME_ZONE=Asia/Hong_Kong
# CORS allow-list for browsers calling the API directly (the Vite proxies do not need it).
# PEMO_ALLOWED_ORIGINS=http://127.0.0.1:23281,http://127.0.0.1:23282
# Requests per minute per client IP (0 disables).
# PEMO_RATE_LIMIT_PER_MINUTE=600
# Page size defaults for list reads.
# PEMO_PAGE_DEFAULT=2000
# PEMO_PAGE_MAX=2000
# Background delivery of queued outbox email (safe with several replicas).
# PEMO_MAIL_WORKER=1
# First line of invoice emails (was hard-coded to one estate).
# PEMO_INVOICE_HEADER=Wing Fu Garden management fee invoice
# SMTP: unset = log-only transport. SMTP_URL=smtp(s)://user:pass@host:port or SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS.
# SMTP_FROM=invoices@wingfu.example
