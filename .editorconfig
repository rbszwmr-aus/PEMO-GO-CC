# PEMO shared editor settings. Created by API-005-ST with the rest of the
# repository root, so that no downstream PID needs to edit a root file.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml,json}]
indent_size = 2

[*.dart]
indent_size = 2

[Makefile]
indent_style = tab
